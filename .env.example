# ============================================================================
# We HR — Environment Variables Configuration Example
# Copy this file to ".env" for local development.
# NEVER commit your actual ".env" file or production secrets to Git.
# ============================================================================

# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Security & Authentication
# Generate a strong random secret in production (e.g. 64 hex characters)
JWT_SECRET=replace-with-a-strong-64-char-random-secret-before-production
JWT_EXPIRES_IN_SECONDS=28800

# Database Mode
# "sqlite" uses Node.js 24 built-in SQLite (free, zero external setup for local dev)
# "postgres" connects to PostgreSQL / Supabase in production
DB_DRIVER=sqlite
SQLITE_DB_PATH=./data/we_hr.db

# Optional: Supabase / PostgreSQL Configuration (for cloud deployment)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Attendance & Geofencing Default Policies
DEFAULT_MAX_LOCATION_ACCURACY_METERS=50
DEFAULT_MAX_LOCATION_AGE_SECONDS=120
OFFLINE_EVENT_MAX_AGE_HOURS=24
MAX_PLAUSIBLE_SPEED_MPS=55

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Set to "true" when running behind a hosting proxy (Render, etc.) so rate limits use the real client IP
TRUST_PROXY=false

# Password for the seeded owner platform admins "ezz" and "nakkady" (default 123456)
SEED_ADMIN_PASSWORD=
